# URL base del backend (proxy del calendario de Google).
# Copia este archivo a .env y ajusta si el backend corre en otro host/puerto.
VITE_API_URL=http://localhost:3001

# La key pública del basemap se configura en backend/.env como
# ARCGIS_BASEMAP_API_KEY. No pongas aquí ARCGIS_CLIENT_SECRET ni credenciales
# de routing; ninguna variable VITE_* debe contener secretos.
