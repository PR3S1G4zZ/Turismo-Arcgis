# Dependencias
node_modules/
frontend/node_modules/
backend/node_modules/

# Imágenes subidas por el usuario (se conservan en el servidor, no en git)
backend/uploads/*
!backend/uploads/.gitkeep

# Build de producción (se genera con "npm run build")
frontend/dist/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Variables de entorno — cualquier variante, en cualquier carpeta.
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Copias de seguridad / exports que alguien pueda dejar sueltos con secretos
# dentro (backend/.env.bak-turismo fue exactamente este caso).
*.bak
*.bak-*
*-backup
*-backup.*
*_backup
*_backup.*
*.orig

# Credenciales y claves sueltas, por si alguien las deja fuera de un .env.
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
secrets.yml
secrets.yaml
service-account*.json

# Datos de MySQL en Docker (si se monta como bind mount en vez de volumen nombrado)
mysql-data/

# Archivos temporales / scratch
scratch_*.json
scratch_*.html

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Worktrees y artefactos de ejecución de Superpowers
.worktrees/
.superpowers/
