# ─── Servidor ───────────────────────────────────────────────
# Puerto en el que escucha el backend.
PORT=3001

# Orígenes permitidos por CORS, separados por comas.
# En desarrollo, el frontend de Vite corre en http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# URL pública del propio backend (para construir las URLs de las imágenes subidas).
# En producción, la URL real del servidor de la Alcaldía. En local:
PUBLIC_URL=http://localhost:3001

# Maximum time per external routing request (ArcGIS/OSRM), in milliseconds.
# If ArcGIS exceeds this limit, the backend tries OSRM.
ROUTING_HTTP_TIMEOUT_MS=8000

# ─── Base de datos MySQL ────────────────────────────────────
# Si usas el docker-compose.yml de la raíz para levantar MySQL en contenedor,
# estos valores deben coincidir con los de tu .env raíz (MYSQL_USER,
# MYSQL_PASSWORD, MYSQL_DATABASE, MYSQL_PORT). DB_HOST sigue siendo
# "localhost": el contenedor expone el puerto al host, no hace falta el
# nombre del servicio de Docker.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=turismo_itagui

# ─── Rutas y navegación (ArcGIS) ────────────────────────────
# Hay dos formas de autenticarse. Basta con UNA. Si no se configura ninguna, el
# ruteo cae al servidor público de OSRM (válido para desarrollo, NO para
# producción: es un servidor de demostración sin garantías).
# NUNCA pongas estos valores en el frontend: solo el backend debe conocerlos.

# OPCIÓN A (recomendada) — Credenciales de OAuth 2.0 de aplicación.
# En arcgis.com: Contenido → Mis contenidos → Nuevo elemento →
#   Credenciales de desarrollador → Credenciales de OAuth 2.0 (autenticación de
#   aplicaciones). El backend pide y renueva el token solo.
# Es la vía a usar cuando la cuenta no puede crear claves de API.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# URL de referencia. DEBE coincidir con una de las "URL de referencia" que se
# registraron al crear las credenciales; si no coincide, ArcGIS rechaza el token
# con un error de referer no válido. Node no envía esta cabecera por su cuenta,
# de modo que el backend la manda explícitamente en cada petición.
# En desarrollo: http://localhost:3001 — en producción, el dominio del portal.
# Un comodín registrado (https://*.itagui.gov.co) exige poner aquí un dominio
# concreto que encaje (https://turismo.itagui.gov.co), no el comodín.
ARCGIS_REFERER=http://localhost:3001

# OPCIÓN B — API key directa (requiere privilegio de administrador para
# generarla, con el permiso de "Routing" / premium:user:networkanalysis).
ARCGIS_API_KEY=

# ─── Seguridad / Autenticación ──────────────────────────────
# Secreto para firmar los JWT. GENERA UNO LARGO Y ALEATORIO EN PRODUCCIÓN.
# Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Vigencia del token de sesión del administrador.
JWT_EXPIRES_IN=8h

# Credenciales del super-administrador inicial. Se crea automáticamente la
# primera vez que arranca el backend si aún no existe ningún usuario.
# CAMBIA LA CONTRASEÑA y, una vez creado, este valor deja de usarse.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Itagui2026*Cambiar
SEED_ADMIN_NAME=Administrador Principal
