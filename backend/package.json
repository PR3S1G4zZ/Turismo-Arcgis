{
  "name": "turismo-itagui-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend del portal Turismo Itagüí: API REST (MySQL) para sitios, anuncios, eventos, PQRS, autenticación de administradores y proxy del calendario de Google.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "init-db": "node src/scripts/initDb.js",
    "seed-sites": "node src/scripts/seedSites.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.12.0",
    "node-ical": "^0.20.1"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^4.1.11"
  }
}
