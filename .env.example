# .env.example (raíz)
# Variables para `docker compose up -d` — SOLO configuran el contenedor de
# MySQL (y Adminer). Las variables del backend (JWT, ArcGIS, etc.) siguen en
# backend/.env; las del frontend en frontend/.env. Copia este archivo a `.env`
# junto a docker-compose.yml.

# ─── MySQL (contenedor Docker) ──────────────────────────────
# Contraseña del usuario root del contenedor. Requerida por la imagen oficial.
MYSQL_ROOT_PASSWORD=cambia-esto

# Base de datos que se crea automáticamente al primer arranque.
MYSQL_DATABASE=turismo_itagui

# Usuario de aplicación (no root) que la imagen crea con permisos completos
# sobre MYSQL_DATABASE. Usa este usuario en backend/.env, no root.
MYSQL_USER=turismo_app
MYSQL_PASSWORD=cambia-esto-tambien

# Puerto expuesto en tu máquina. Debe coincidir con DB_PORT en backend/.env.
MYSQL_PORT=3307
